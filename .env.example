# Copy to .env and fill in. NEVER commit the real .env.

# --- Required ---
GOOGLE_API_KEY=your-gemini-api-key

# --- Optional realtime features ---
SERPAPI_KEY=your-serpapi-key
CALENDARIFIC_API_KEY=your-calendarific-key

# --- Real-time knowledge layer ---
# Jarvis auto-searches the live web only for current-info queries (news/today/
# latest/stock/weather/sports/…); timeless queries ("what is Python") don't search.
REALTIME_ENABLED=true
REALTIME_PROVIDER=auto          # auto | serpapi | duckduckgo
REALTIME_MAX_RESULTS=5
REALTIME_EXTRACT=true           # fetch+clean top article pages
REALTIME_MAX_EXTRACT_ARTICLES=3
REALTIME_SUMMARIZE=false        # true = pre-condense to a 150-word briefing (extra LLM call)
# REALTIME_SUMMARIZER_MODEL=gemini-2.5-flash-lite
# Cache TTLs (seconds): news=30m, weather=15m, general=12h
REALTIME_TTL_NEWS_S=1800
REALTIME_TTL_WEATHER_S=900
REALTIME_TTL_GENERAL_S=43200

# --- LLM ---
GEMINI_MODEL=gemini-2.0-flash
ASSISTANT_NAME=Jarvis

# --- STT (faster-whisper) ---
STT_MODEL_SIZE=small          # tiny|base|small|medium|large-v3
STT_DEVICE=auto               # auto|cuda|cpu
# STT_COMPUTE_TYPE=int8       # leave blank to auto-pick (int8 cpu / int8_float16 cuda)
STT_BEAM_SIZE=1               # 1 = greedy = fastest
# STT_LANGUAGE=               # blank = auto multilingual; or en|hi|te

# --- VAD ---
VAD_AGGRESSIVENESS=2          # 0..3
VAD_SILENCE_MS=600
VAD_MIN_UTTERANCE_MS=250
VAD_MAX_UTTERANCE_MS=12000

# --- TTS voices ---
TTS_VOICE_EN=en-GB-RyanNeural
TTS_VOICE_HI=hi-IN-MadhurNeural
TTS_VOICE_TE=te-IN-MohanNeural

# --- Barge-in ---
# Set true if the mic hears the assistant's own voice and self-interrupts.
BARGE_IN_KEYWORDS_ONLY=false

# --- Misc ---
DEMO_MODE=false               # true = headless console input (no microphone)

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Separate offline human annotation; not a production schema",
  "type": "object",
  "required": [
    "judgment",
    "review_kind",
    "reviewer_type",
    "reviewer_id",
    "prediction_blinded",
    "input_sha256",
    "rubric_sha256",
    "qualification",
    "label",
    "field_rationale",
    "notes",
    "timestamp"
  ],
  "additionalProperties": false,
  "properties": {
    "judgment": {
      "enum": [
        "pending",
        "labeled",
        "ambiguous",
        "unresolved"
      ]
    },
    "review_kind": {
      "enum": [
        "independent",
        "self_review",
        "historical_reference",
        null
      ]
    },
    "reviewer_type": {
      "enum": [
        "human",
        "AI",
        null
      ]
    },
    "reviewer_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "prediction_blinded": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "input_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "rubric_sha256": {
      "type": "string"
    },
    "qualification": {
      "type": "object",
      "required": [
        "languages",
        "scripts",
        "transliteration"
      ],
      "properties": {
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scripts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "transliteration": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "label": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "intent_family",
            "execution_path",
            "capability_family",
            "context_requirements",
            "clarification",
            "uncertainty",
            "escalation"
          ],
          "properties": {
            "intent_family": {
              "enum": [
                "conversation",
                "information",
                "deterministic_action",
                "local_task",
                "research",
                "memory",
                "multi_step_task",
                "clarification",
                "unsupported"
              ]
            },
            "execution_path": {
              "enum": [
                "fast_path",
                "respond",
                "qwen_agent",
                "memory",
                "research",
                "clarify",
                "escalate"
              ]
            },
            "capability_family": {
              "enum": [
                "none",
                "application",
                "browser",
                "file",
                "project",
                "weather",
                "location",
                "reminder",
                "memory",
                "research",
                "system",
                "unknown"
              ]
            },
            "uncertainty": {
              "enum": [
                "high",
                "medium",
                "low",
                "ambiguous",
                "outside_envelope"
              ]
            },
            "context_requirements": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "conversation",
                  "memory",
                  "project",
                  "current_information",
                  "observations",
                  "active_task",
                  "none"
                ]
              }
            },
            "clarification": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "required",
                "missing"
              ],
              "properties": {
                "required": {
                  "type": "boolean"
                },
                "missing": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "target",
                      "file",
                      "application",
                      "url",
                      "query",
                      "location",
                      "time",
                      "scope",
                      "permission",
                      "reference"
                    ]
                  }
                }
              }
            },
            "escalation": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "candidate",
                "reason"
              ],
              "properties": {
                "candidate": {
                  "type": "boolean"
                },
                "reason": {
                  "enum": [
                    "current_information_required",
                    "unsupported_capability",
                    "outside_qwen_envelope",
                    "repeated_local_failure",
                    "context_overload",
                    "explicit_cloud_request",
                    null
                  ]
                }
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "field_rationale": {
      "type": "object",
      "required": [
        "intent_family",
        "capability_family",
        "execution_path",
        "context_requirements",
        "clarification.required",
        "clarification.missing",
        "escalation.candidate",
        "escalation.reason",
        "uncertainty"
      ],
      "additionalProperties": false,
      "properties": {
        "intent_family": {
          "type": "string"
        },
        "capability_family": {
          "type": "string"
        },
        "execution_path": {
          "type": "string"
        },
        "context_requirements": {
          "type": "string"
        },
        "clarification.required": {
          "type": "string"
        },
        "clarification.missing": {
          "type": "string"
        },
        "escalation.candidate": {
          "type": "string"
        },
        "escalation.reason": {
          "type": "string"
        },
        "uncertainty": {
          "type": "string"
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "timestamp": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "judgment": {
            "const": "labeled"
          }
        }
      },
      "then": {
        "properties": {
          "label": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "intent_family",
              "execution_path",
              "capability_family",
              "context_requirements",
              "clarification",
              "uncertainty",
              "escalation"
            ],
            "properties": {
              "intent_family": {
                "enum": [
                  "conversation",
                  "information",
                  "deterministic_action",
                  "local_task",
                  "research",
                  "memory",
                  "multi_step_task",
                  "clarification",
                  "unsupported"
                ]
              },
              "execution_path": {
                "enum": [
                  "fast_path",
                  "respond",
                  "qwen_agent",
                  "memory",
                  "research",
                  "clarify",
                  "escalate"
                ]
              },
              "capability_family": {
                "enum": [
                  "none",
                  "application",
                  "browser",
                  "file",
                  "project",
                  "weather",
                  "location",
                  "reminder",
                  "memory",
                  "research",
                  "system",
                  "unknown"
                ]
              },
              "uncertainty": {
                "enum": [
                  "high",
                  "medium",
                  "low",
                  "ambiguous",
                  "outside_envelope"
                ]
              },
              "context_requirements": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": [
                    "conversation",
                    "memory",
                    "project",
                    "current_information",
                    "observations",
                    "active_task",
                    "none"
                  ]
                }
              },
              "clarification": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "required",
                  "missing"
                ],
                "properties": {
                  "required": {
                    "type": "boolean"
                  },
                  "missing": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "target",
                        "file",
                        "application",
                        "url",
                        "query",
                        "location",
                        "time",
                        "scope",
                        "permission",
                        "reference"
                      ]
                    }
                  }
                }
              },
              "escalation": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "candidate",
                  "reason"
                ],
                "properties": {
                  "candidate": {
                    "type": "boolean"
                  },
                  "reason": {
                    "enum": [
                      "current_information_required",
                      "unsupported_capability",
                      "outside_qwen_envelope",
                      "repeated_local_failure",
                      "context_overload",
                      "explicit_cloud_request",
                      null
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "judgment": {
            "enum": [
              "pending",
              "ambiguous",
              "unresolved"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "label": {
            "type": "null"
          }
        }
      }
    }
  ],
  "description": "Actual validate_label/check_judgment additionally enforce frozen cross-field constraints, rationale, qualification and provenance; schema shape alone does not establish independent review."
}
